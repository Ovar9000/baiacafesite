# Baia Cafe - Environment Variables Template
# Copy this file to .env or .env.local for local development

# Environment Mode
VITE_APP_ENV=development

# Facebook Graph API Configuration (for sync script)
FB_PAGE_ID=thebaiacafe
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Google Gemini API Key (for post classification)
GEMINI_API_KEY=your_gemini_api_key_here
