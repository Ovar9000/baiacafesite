# Baia Cafe - Environment Variables Template
# Copy this file to .env or .env.local for local development

# Environment Mode
VITE_APP_ENV=development

# Facebook Graph API Configuration (for sync script)
FB_PAGE_ID=thebaiacafe
FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# Google Gemini API Key (for post classification)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration
# Public values are safe to commit; secrets below are placeholders ONLY — never commit real secrets.
# (Can be found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://cqtcmrqlafgtcrcfaojz.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_URL=https://cqtcmrqlafgtcrcfaojz.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here

# Digital Loyalty Card Config
# Generate strong secrets with: openssl rand -hex 32
DAILY_QR_SECRET=REPLACE_WITH_openssl_rand_hex_32
CAFE_LAT=13.6218
CAFE_LNG=123.1948
CAFE_MAX_RADIUS_METERS=75
CAFE_TIMEZONE=Asia/Manila
ADMIN_PASSWORD=REPLACE_WITH_openssl_rand_base64_32
